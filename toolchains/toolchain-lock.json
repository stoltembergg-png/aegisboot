{
  "$schema": "https://aegisboot.dev/schema/toolchain-lock.v1.json",
  "schema_version": "1.1.0",
  "distribution": "AegisBoot",
  "base_toolchains": {
    "llvm_clang": {
      "name": "LLVM / Clang Compiler Suite",
      "version": "21.0.0",
      "triplets": {
        "X64": "x86_64-pc-win32-coff",
        "Ia32": "i686-pc-win32-coff",
        "AArch64": "aarch64-linux-gnu"
      },
      "flags": {
        "common": ["-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing", "-fno-stack-protector", "-fno-builtin"],
        "reproducible": ["-Wdate-time", "-fmacro-prefix-map=.", "-ffile-prefix-map=."],
        "release": ["-O3", "-flto"],
        "debug": ["-O0", "-g"],
        "noopt": ["-O0"]
      }
    },
    "gcc": {
      "name": "GNU Compiler Collection",
      "version": "13.2.0",
      "packages": ["gcc-multilib", "gcc-x86-64-linux-gnu", "i686-w64-mingw32-gcc"],
      "flags": {
        "common": ["-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing"],
        "reproducible": ["-Wdate-time", "-fmacro-prefix-map=.", "-ffile-prefix-map=."],
        "release": ["-Os", "-flto"],
        "debug": ["-Og", "-g"]
      }
    },
    "nasm": {
      "version": "2.16.03",
      "sha256": "55c4794eab3d82a17cb6eecdd18f8da0fa7270e5b72186835a09ee4f23b2c286",
      "flags": ["-f", "win64", "-DWIN64"]
    },
    "iasl": {
      "version": "20240827",
      "sha256": "4b68ff5e13d9cf8b1a8d05cf4e8a4a35ec11b5e3240e87b7a1496a79e4ea095c",
      "flags": ["-we", "-vr"]
    }
  },
  "environments": {
    "docker_images": {
      "oc_dev_edk2": {
        "base_image": "ubuntu:24.04",
        "digest": "sha256:72297848456d5d37d1262630108ab308d3e9ec7ed1c3286a32fe09856619a782"
      },
      "oc_dev_docs": {
        "base_image": "ubuntu:24.04",
        "digest": "sha256:72297848456d5d37d1262630108ab308d3e9ec7ed1c3286a32fe09856619a782"
      }
    },
    "system_packages": {
      "ubuntu_24_04": [
        "build-essential",
        "nasm",
        "iasl",
        "uuid-dev",
        "libssl-dev",
        "libx11-dev",
        "libxext-dev",
        "gcc-multilib",
        "gcc-x86-64-linux-gnu",
        "curl",
        "git",
        "zip",
        "python3"
      ],
      "macos_homebrew": [
        "FiloSottile/musl-cross/musl-cross",
        "mingw-w64",
        "nasm"
      ],
      "windows_choco": [
        "make",
        "nasm",
        "zip",
        "iasl"
      ]
    }
  },
  "matrix_definitions": {
    "architectures": ["X64", "Ia32"],
    "targets": ["RELEASE", "DEBUG", "NOOPT"],
    "toolchains": ["CLANGPDB", "GCC", "CLANGDWARF", "XCODE5", "VS2022"]
  }
}
